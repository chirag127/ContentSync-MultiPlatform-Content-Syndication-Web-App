{
    "name": "omni-publisher-ecosystem",
    "version": "1.0.0",
    "description": "A production-ready content ecosystem for publishing to multiple platforms.",
    "main": "dist/publish.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/publish.js",
        "publish": "ts-node src/publish.ts",
        "build-site": "ts-node src/build-site.ts",
        "test": "ts-node src/test/mock-server.ts & ts-node src/publish.ts --mock && echo 'Tests Completed'",
        "lint": "eslint src/**/*.ts"
    },
    "keywords": [
        "publisher",
        "blog",
        "content",
        "automation"
    ],
    "author": "Omni-Publisher Team",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.19.0",
        "chalk": "^6.0.0",
        "commander": "^15.0.0",
        "dotenv": "^17.4.2",
        "fs-extra": "^11.4.0",
        "glob": "^13.0.6",
        "gray-matter": "^4.0.3",
        "js-yaml": "^5.3.0",
        "marked": "^18.0.9",
        "oauth-1.0a": "^2.2.6",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.2",
        "@types/glob": "^9.0.0",
        "@types/js-yaml": "^4.0.8",
        "@types/marked": "^6.0.0",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "ts-node": "^10.9.1",
        "typescript": "^7.0.2"
    }
}